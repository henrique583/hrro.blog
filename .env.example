# Copy to .env.local and fill in. Everything is optional: sources without
# credentials are skipped and posts are shown untranslated.

# X API, from your app's "Keys & Tokens" page in the X developer console.
# Requests are signed as you so they're billed at the cheaper "Owned Reads"
# rate. Consumer Key/Secret: "OAuth 1.0 Keys". Access Token/Secret: the
# "Access Token" row (for @henrique_rro, Read).
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional GitHub token (no scopes needed). Raises the API rate limit.
GITHUB_TOKEN=

# DeepL API key for translating post text (free plan keys end in ":fx").
DEEPL_API_KEY=

# Protects /api/refresh-feed. Vercel's cron job sends it automatically; use
# any long random string (e.g. `openssl rand -hex 32`).
CRON_SECRET=
