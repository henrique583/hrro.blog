# Copy to .env.local and fill in. Everything is optional: sources without
# credentials are skipped and posts are shown untranslated.

# X API v2 bearer token (pay-per-use, developer.x.com).
X_BEARER_TOKEN=
# Your numeric X user id. Optional; saves a lookup on each refresh.
X_USER_ID=

# Optional GitHub token (no scopes needed). Raises the API rate limit.
GITHUB_TOKEN=

# DeepL API key for translating post text (free plan keys end in ":fx").
DEEPL_API_KEY=
